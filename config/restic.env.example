########################################################################
# restic backup automation - main configuration
#
# Copy this file to /etc/restic/restic.env and edit the values below.
# This file is loaded by systemd (EnvironmentFile=) and by every script
# in bin/. It must NOT contain the restic password or AWS keys - those
# live in the separate, more restrictively permissioned secrets.env
# (see config/secrets.env.example).
#
# Permissions: chmod 640, chown root:root (or root:restic if you run
# the service as a dedicated "restic" user).
########################################################################

### --- Repository (S3 / S3 Glacier) ---------------------------------
#
# restic talks to the bucket over the standard S3 backend. The bucket
# (or the specific "data/" prefix inside it) is expected to be backed
# by S3 Glacier storage - either via an AWS storage class / lifecycle
# rule, or via an on-prem S3-compatible gateway that is itself backed
# by tape. restic does not know or care which; it just needs an S3
# endpoint. See docs/glacier-notes.md for important caveats about
# reading data back from Glacier/tape.
#
# Examples:
#   RESTIC_REPOSITORY="s3:s3.amazonaws.com/my-backup-bucket/shares"
#   RESTIC_REPOSITORY="s3:https://s3.eu-west-1.amazonaws.com/my-backup-bucket/shares"
#   RESTIC_REPOSITORY="s3:https://glacier-gateway.example.internal/my-backup-bucket/shares"
RESTIC_REPOSITORY="s3:s3.amazonaws.com/CHANGE-ME-bucket/shares"

# The restic repository password and AWS credentials are loaded from
# the separate secrets.env file (chmod 600, root-only) - see
# config/secrets.env.example. Never put the password or keys
# themselves in this file.
RESTIC_SECRETS_FILE="/etc/restic/secrets.env"

### --- S3 storage class ----------------------------------------------
# Storage class applied to objects written to the bucket. GLACIER is
# required per policy. If your bucket instead uses a lifecycle rule to
# transition objects to Glacier after upload, set this to STANDARD and
# let the lifecycle rule do the transition (see docs/glacier-notes.md).
RESTIC_S3_STORAGE_CLASS="GLACIER"

# Number of concurrent connections restic's S3 backend opens
# (-o s3.connections). This is backend/network parallelism, separate
# from RESTIC_READ_CONCURRENCY below (which is file-read parallelism
# on the source side). Default in restic is 5.
RESTIC_S3_CONNECTIONS=10

### --- Pack size & parallelism ---------------------------------------

# Target pack file size in MiB (restic --pack-size).
RESTIC_PACK_SIZE=64

# Number of files read concurrently during backup (restic
# --read-concurrency). Tune based on CPU/IO of the host and the
# number/size of files on the mounted shares.
RESTIC_READ_CONCURRENCY=4

### --- Cache & temp directories ---------------------------------------
#
# RESTIC_CACHE_DIR is read natively by restic.
# RESTIC_TMP_DIR is NOT a restic-native variable; the wrapper scripts
# export it as TMPDIR (the variable restic and Go's runtime actually
# use for scratch space) so you can keep using the name your team is
# used to. Both directories are created automatically if missing.
RESTIC_CACHE_DIR="/opt/restic/restic-cache"
RESTIC_TMP_DIR="/opt/restic/restic-tmp"

### --- Backup sources & per-share retention -----------------------------
#
# SHARES_FILE lists each share (mount point) and the name of the
# retention policy it should use; RETENTION_POLICIES_FILE defines what
# each named policy actually keeps (keep-daily/weekly/monthly/yearly).
# This is what lets different shares carry different short/mid/long
# retention - see config/shares.conf.example and
# config/retention-policies.conf.example, and the notes in
# bin/restic-common.sh on why this requires one snapshot per share.
SHARES_FILE="/etc/restic/shares.conf"
RETENTION_POLICIES_FILE="/etc/restic/retention-policies.conf"

# restic --exclude-file, applied to every share.
EXCLUDE_FILE="/etc/restic/excludes.txt"

# Optional: maps a share to the NetApp ONTAP SVM/volume backing it, so
# restic-backup.sh backs up a frozen NetApp Snapshot copy of that
# share instead of its live, changing filesystem - see
# config/netapp-volumes.conf.example and "Backing up from a NetApp
# snapshot" in README.md. Leave this file missing entirely (the
# default - nothing to create) for every share to keep backing up
# directly, exactly as without this feature; a share simply isn't
# listed in it to opt out individually once it exists.
NETAPP_VOLUMES_FILE="/etc/restic/netapp-volumes.conf"

# Tag applied to every snapshot created by the automated job (in
# addition to per-share "share:<name>" and "policy:<name>" tags - see
# bin/restic-backup.sh).
RESTIC_BACKUP_TAG="scheduled"

# If set to "true", the backup script refuses to back up a configured
# share that is not currently an active mount point (protects against
# silently backing up an empty local directory when a share failed to
# mount). Recommended: true.
REQUIRE_MOUNTED=true

### --- Maintenance -----------------------------------------------------
#
# restic-maintenance.sh runs `restic forget --path <share> --keep-...`
# once per share (using that share's own policy from
# RETENTION_POLICIES_FILE), then a single `restic prune` for the whole
# repository. --max-repack-size 0 is mandatory on that prune: it stops
# it from repacking (rewriting) pack files that are still partially
# referenced. Repacking requires reading the old pack's data back from
# the repository, which on a Glacier/tape-backed bucket is slow and/or
# costly (retrieval requests, tape mounts). With this flag, prune only
# removes pack files that are 100% unreferenced - no re-read of
# archived data is needed.
RESTIC_MAINTENANCE_EXTRA_ARGS="--max-repack-size 0"

# Run `restic check` (metadata only, no --read-data) as part of
# maintenance. This does NOT read pack data from Glacier/tape, only
# the index/metadata, so it stays cheap. Recommended: true.
RESTIC_RUN_CHECK=true

### --- Restore verification (restic-verify.sh / resticctl verify) -----
#
# Unlike RESTIC_RUN_CHECK above, this DOES read real archived pack
# data - it samples a few files per share and proves they're actually
# restorable, not just present. Confirmed against this repo's real
# destination (scrat-1.ctie.etat.lu): reads need an explicit tape
# recall first, so RESTIC_VERIFY_USE_S3_RESTORE defaults to true.
#
# There is deliberately NO systemd timer for this - a real restore can
# take minutes to many hours depending on the tape robot, and running
# it unattended on a schedule was judged too risky. There is also
# deliberately no configured restore-target directory here: it's a
# required command-line argument every time
# (`resticctl verify --target <path>`), a manual/deliberate choice of
# where there's free disk space to restore into, rather than a fixed
# setting that could go stale or point somewhere without room.
# (VERIFY_LOG_FILE is set below, in the Logging section.)

# How many files to sample per share on each run.
RESTIC_VERIFY_SAMPLE_FILES=3

# true (default, required for this repo's destination): restore each
# sampled file via restic's two-step S3 Glacier restore sequence
# (RESTIC_FEATURES=s3-restore, -o s3.enable-restore=1 to trigger the
# tape recall, then the plain restore below) into the directory given
# via --target on the command line, then confirm the file landed with
# non-zero size. Set to false only if your destination serves reads
# transparently (no restore step needed) - that uses the older,
# cheaper `restic dump`-per-file approach instead, which needs no
# --target at all.
RESTIC_VERIFY_USE_S3_RESTORE=true

# -o s3.restore-days: how many days the thawed copy stays available on
# the Glacier side before reverting to archive.
RESTIC_VERIFY_RESTORE_DAYS=1

# The confirmed behavior on this destination: the trigger call
# (-o s3.enable-restore=1) itself reliably FAILS, even though the tape
# recall proceeds in the background on the gateway's own cache
# regardless - so restic-verify.sh logs that failure but never treats
# it as fatal. It then makes exactly ONE attempt at the plain restore
# step - no internal retry/poll loop, on purpose: a script that sleeps
# and retries on its own for potentially hours is really just a
# schedule under a different name, which is exactly what this tool is
# not supposed to be. If the data isn't back from tape yet, this run
# simply fails and tells you so; re-run the whole command yourself
# later to check again - that's the manual part.
#
# RESTIC_VERIFY_RESTORE_TIMEOUT is passed as-is to restic's own
# -o s3.restore-timeout on the trigger call (a Go duration string:
# "24h", "90m", "1h30m", ...); it does not control anything on our
# side since there's no retry loop here to bound.
RESTIC_VERIFY_RESTORE_TIMEOUT="24h"

# Max seconds any single restic invocation (the trigger call, or the
# one plain-restore attempt) is allowed to run before being killed.
RESTIC_VERIFY_ATTEMPT_TIMEOUT=120

# Only used when RESTIC_VERIFY_USE_S3_RESTORE=false.
# Max seconds to wait for a single file's content to come back via
# `restic dump` before giving up on it.
RESTIC_VERIFY_TIMEOUT=300

### --- Locking (backup / maintenance mutual exclusion) ----------------
#
# Backup and maintenance share this lock file so they can never run
# against the repository at the same time:
#   - restic-backup.sh waits up to RESTIC_BACKUP_LOCK_TIMEOUT seconds
#     to acquire it (in case maintenance is still finishing up), then
#     fails loudly if it still can't get the lock.
#   - restic-maintenance.sh tries once, immediately: if backup is
#     still running (holds the lock), maintenance logs that and exits
#     cleanly without doing anything, and simply tries again at its
#     next scheduled run.
RESTIC_LOCK_FILE="/run/restic/restic.lock"
RESTIC_BACKUP_LOCK_TIMEOUT=300

# How many restic-backup@<share>.service instances are allowed to
# actually run `restic backup` (the memory-heavy part) at the same
# time. All configured shares are still *started* at once by the
# daily dispatcher (or resticctl backup-all) - this only bounds how
# many of them are doing the expensive part simultaneously; the rest
# queue and wait their turn (polling every 30s, logged once).
#
# Each concurrent `restic backup` process can use several GB to tens
# of GB of memory depending on RESTIC_READ_CONCURRENCY, pack buffers,
# and the share's own size - with enough shares actually running their
# backup at the same moment, that adds up far faster than most hosts
# have RAM for. Size this to (available RAM - everything else running)
# / (peak memory you've observed for one `restic backup`, via
# `systemctl status restic-backup@<share>.service` while it runs) - not
# by number of shares, which is unrelated to how much RAM you have.
#
# This only bounds the *count* running at once, not how much memory
# any single one of them uses - if one share's backup is, by itself,
# big enough to exhaust the host (observed on manny-01: one share
# alone peaked at 21.5G of a 32G host), this setting alone won't save
# you even at 1. See the MemoryHigh/MemoryMax comment in
# systemd/restic-backup@.service and restic-backup.slice for the
# complementary (and more important, if you only pick one) memory-cap
# safety net - keep those in sync with your host's actual RAM whenever
# you change it.
#
# Set to 8, matching manny-01's ~500G physical host (covers every
# currently configured share running at once) and the 40G/56G
# per-instance + 400G/450G slice-aggregate MemoryHigh/MemoryMax sized
# for it (see systemd/restic-backup@.service and restic-backup.slice).
#
# IMPORTANT: this value and those systemd limits were sized together -
# don't raise this past what the current MemoryHigh/MemoryMax actually
# budget for. On a smaller host, drop both proportionally - e.g. the
# previous 64G-VM sizing (RESTIC_BACKUP_MAX_PARALLEL=4, 12G/16G
# per-instance, 40G/48G slice) is in git history.
RESTIC_BACKUP_MAX_PARALLEL=8

### --- Logging -----------------------------------------------------------

LOG_DIR="/var/log/restic"
BACKUP_LOG_FILE="${LOG_DIR}/backup.log"
MAINTENANCE_LOG_FILE="${LOG_DIR}/maintenance.log"
VERIFY_LOG_FILE="${LOG_DIR}/verify.log"
REPORT_LOG_FILE="${LOG_DIR}/report.log"

# Also emit restic's own machine-readable progress as JSON lines into
# the log (restic backup --json). Set to false for plain human output.
RESTIC_JSON_LOG=true

### --- Notifications on failure -----------------------------------------
#
# Every job (backup, maintenance, verify) always writes a small
# key=value status file to RESTIC_STATUS_DIR, e.g.
# /var/log/restic/status/backup.status - useful with zero
# configuration for any external monitoring (Nagios, Zabbix, a simple
# cron check) that wants to poll "did the last run succeed".
RESTIC_STATUS_DIR="/var/log/restic/status"

# From: header for every email this system sends (failure
# notifications and the daily report). Without this, the local
# MTA/mail command falls back to the OS account running the job (you
# get emails from something like "Super User <root@...>") - set a
# real display name/address here instead.
RESTIC_NOTIFY_FROM="Restic Backup <restic@$(hostname -f 2>/dev/null || hostname)>"

# Email address to notify (whatever your local `mail`/`sendmail`
# accepts - a distribution list is fine). Leave empty to disable email
# notifications. Requires a local MTA/relay to actually be configured
# (postfix, sendmail, ssmtp, ...) - if none is, notify() logs an error
# to the job's own log file rather than failing the job itself.
RESTIC_NOTIFY_EMAIL=""

# Optional webhook URL (Slack/Teams-compatible incoming webhook that
# accepts {"text": "..."}). Leave empty to disable.
RESTIC_NOTIFY_WEBHOOK_URL=""

# "failure" (default): only send a notification when a job fails or
# completes with warnings - not on every routine success.
# "always": also notify on full success (a daily "all good" ping).
RESTIC_NOTIFY_ON="failure"

### --- Daily report (restic-report.sh / resticctl report) -------------
#
# This is a backup report, not a server-health digest: it only reads
# fast repository metadata (`restic snapshots`) - never archived pack
# data, and never backup/maintenance/verify status (that's what
# RESTIC_NOTIFY_* above and the RESTIC_STATUS_DIR status files are
# for) - so it's safe to schedule daily (see
# systemd/restic-report.timer). It emails one plain-text table with
# the latest snapshot of every configured share, regardless of
# RESTIC_NOTIFY_ON above - the daily report is a separate, deliberate
# "did everything actually back up" digest, not a failure alert.

# Recipient for the daily report. Leave empty to reuse
# RESTIC_NOTIFY_EMAIL instead; if both are empty, the report is still
# generated and logged to REPORT_LOG_FILE, just not emailed.
RESTIC_REPORT_EMAIL=""

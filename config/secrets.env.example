########################################################################
# All secrets for restic in one place: the repository password and the
# AWS credentials for the S3 backend.
#
# Copy to /etc/restic/secrets.env
# chmod 600, chown root:root - this file contains secrets and must
# never be group- or world-readable.
#
# Prefer a dedicated IAM user/role scoped to exactly this bucket/prefix
# with only the permissions restic needs:
#   s3:ListBucket, s3:GetObject, s3:PutObject, s3:DeleteObject,
#   s3:GetBucketLocation, s3:AbortMultipartUpload,
#   s3:ListMultipartUploadParts
# plus s3:PutObjectTagging if s3.storage-class is used with certain
# bucket policies.
########################################################################

# The restic repository password. Picking a strong, unique passphrase
# matters: anyone with this password and read access to the bucket can
# decrypt every backup.
#
# More secure alternative: leave RESTIC_PASSWORD unset and instead set
# RESTIC_PASSWORD_FILE=/path/to/password (or RESTIC_PASSWORD_COMMAND)
# in restic.env or here - bin/restic-common.sh accepts any one of the
# three (same as restic itself) and passes whichever is set straight
# through to restic unread, so the password never sits in this
# process's own environment as plain text the way RESTIC_PASSWORD
# does. Set exactly one of the three, not several at once.
RESTIC_PASSWORD="CHANGE-ME"

# More secure alternative: leave these two unset and set
# AWS_PROFILE=<name> instead (in restic.env or here), with the actual
# keys in the credentials file for that profile (e.g.
# ~/.aws/credentials of whichever user runs the backup services - root
# by default, since the systemd units don't set User=). The AWS SDK
# only falls back to a profile when AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY are actually unset - don't set both an
# AWS_PROFILE and these two at once, or the literal keys win silently.
#
# IMPORTANT if using AWS_PROFILE: also set AWS_SHARED_CREDENTIALS_FILE
# below to the credentials file's full path. "~/.aws/credentials"
# only resolves correctly when $HOME is set, which is true in an
# interactive root shell but NOT guaranteed for a systemd service with
# no User= - confirmed on manny-01: `resticctl backup <share>` run by
# hand worked, but the exact same config run via
# restic-backup@<share>.service failed with "no credentials found",
# because $HOME was empty in the service's environment. Setting this
# explicitly removes the dependency on $HOME entirely, so both paths
# behave identically.
AWS_ACCESS_KEY_ID="CHANGE-ME"
AWS_SECRET_ACCESS_KEY="CHANGE-ME"
# AWS_SHARED_CREDENTIALS_FILE="/root/.aws/credentials"

# Only needed for AWS S3 (not for most S3-compatible gateways).
AWS_DEFAULT_REGION="eu-west-1"

# Only needed if /etc/restic/netapp-volumes.conf exists (see
# config/netapp-volumes.conf.example and "Backing up from a NetApp
# snapshot" in README.md) - a dedicated NetApp user, scoped to exactly
# "create/delete/read a Snapshot copy on these volumes", nothing
# broader (never the cluster admin account), and the same on every SVM
# (ONTAP local users are per-SVM, so this means creating the identical
# username/password on each one). The API *endpoint* for each SVM -
# its own data LIF, not a cluster management LIF - is configured
# separately in NETAPP_SVMS_FILE (restic.env) /
# config/netapp-svms.conf.example, since several shares/volumes
# commonly share one SVM.
NETAPP_API_USER="CHANGE-ME"
# More secure alternative: leave this unset and set
# NETAPP_API_PASSWORD_FILE=/path/to/password instead - same reasoning
# as RESTIC_PASSWORD_FILE above.
NETAPP_API_PASSWORD="CHANGE-ME"
# Path to the CA bundle that signed ONTAP's REST API certificate.
# Required - this project never disables TLS verification. If ONTAP
# is using a self-signed cert, export it once
# (`openssl s_client -connect <lif>:443 -showcerts`) and point this at
# a file containing it.
NETAPP_API_CACERT="/etc/restic/netapp-ca.pem"

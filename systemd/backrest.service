[Unit]
Description=Backrest (read-only snapshot browser for the restic repository)
Documentation=https://github.com/garethgeorge/backrest
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/restic/secrets.env

[Service]
Type=simple
User=backrest
Group=backrest
# Reads the SAME two files restic-backup.sh itself sources (in the
# same order, so overlap resolves the same way) rather than a
# duplicated copy - this host actually has both a RESTIC_PASSWORD_FILE/
# AWS_PROFILE setup in restic.env AND literal RESTIC_PASSWORD/
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in secrets.env at once, and
# which one restic/the AWS SDK actually prefers isn't this unit's
# business to guess - inheriting the exact same environment the real
# backups use means Backrest authenticates exactly the same way,
# whichever that turns out to be. bin/install-backrest.sh grants this
# service's user read access to secrets.env via a POSIX ACL (`setfacl`)
# rather than changing that file's own ownership/permissions.
EnvironmentFile=/etc/restic/restic.env
EnvironmentFile=/etc/restic/secrets.env
# -restic-cmd points Backrest at the SAME restic binary already
# installed for the main backup automation, rather than letting it
# silently download and manage its own copy - one restic version in
# use on this host, not two. Adjust the path if `restic` isn't at
# /usr/bin/restic here (`which restic`).
Environment="BACKREST_PORT=:9898"
Environment="BACKREST_CONFIG=/etc/backrest/config.json"
Environment="BACKREST_DATA=/var/lib/backrest"
Environment="BACKREST_RESTIC_COMMAND=/usr/bin/restic"
Environment="XDG_CACHE_HOME=/var/lib/backrest/cache"
ExecStart=/opt/backrest/bin/backrest
Restart=on-failure
RestartSec=5

# Exposed on every interface (`:9898`, Backrest's own documented
# syntax for "listen on all interfaces") rather than 127.0.0.1-only,
# since this runs on manny-01's protected backup network and doesn't
# need an SSH tunnel there. Backrest has its own built-in auth (local
# username/password, bcrypt-hashed) enforced on every request - the
# first visit to the UI forces you to create that account before
# anything else is reachable. It has no built-in TLS, so traffic
# (including the login) is plain HTTP; if that network needs
# encryption in transit too, put a TLS-terminating reverse proxy in
# front instead of changing this. If you want to narrow this further
# than "every interface", set BACKREST_PORT to a specific IP:port
# (e.g. the backup network's own interface) instead of `:9898`, and/or
# restrict access with a host firewall rule scoped to that network.
# See README.md for the full setup (importing the existing repo as a
# Repo without ever adding a Plan, and why its browse/restore features
# should be avoided here).

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

StandardOutput=journal
StandardError=journal
SyslogIdentifier=backrest

# Basic hardening. ProtectSystem=full makes /usr, /boot and /etc
# read-only for this service by default - Backrest needs to write its
# own config.json (BACKREST_CONFIG=/etc/backrest/config.json above,
# e.g. when creating the admin account or adding a repo through the
# UI), so /etc/backrest is explicitly carved out here alongside its
# data directory. It still reads /etc/restic/{restic,secrets}.env (see
# the EnvironmentFile= lines above) but has no write access there, nor
# to /opt/restic or /var/log/restic.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/backrest /var/lib/backrest

TimeoutStartSec=30

[Install]
WantedBy=multi-user.target

[Unit]
Description=restic backup of share %i to S3 Glacier
Documentation=https://restic.readthedocs.io/
Wants=network-online.target
After=network-online.target
# If this share is a systemd .mount unit (or uses x-systemd.automount
# in /etc/fstab), list it here so this instance waits for it instead
# of racing the mount at boot, e.g. for instance "finance":
#   RequiresMountsFor=/mnt/share-finance
ConditionPathExists=/etc/restic/restic.env

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/restic.env
ExecStart=/opt/restic/bin/restic-backup.sh %i

# All restic-backup@<share> instances share this slice (see
# systemd/restic-backup.slice), which caps their *combined* memory -
# this directive instead caps what ONE instance alone can use.
# RESTIC_BACKUP_MAX_PARALLEL (restic.env) bounds how many instances
# run `restic backup` at once, which protects against several
# moderate-sized backups adding up to too much memory together - it
# does nothing if a single share's backup is, by itself, big enough to
# exhaust the host (observed on manny-01: one share alone peaked at
# 21.5G). These two MemoryHigh/MemoryMax values are that second,
# independent safety net: past MemoryHigh the kernel throttles/
# reclaims this cgroup instead of letting it grow further; past
# MemoryMax the kernel's cgroup-aware OOM killer kills processes
# *inside this cgroup only* - this specific backup fails, instead of
# the whole host OOMing and (as actually happened) rebooting.
#
# Sized for manny-01's hardware migration to a ~500G physical host
# (RESTIC_BACKUP_MAX_PARALLEL=8, see restic.env, covering every
# currently configured share running at once): reserve ~50G for the
# OS/page cache/other restic jobs, leaving a 450G budget for this
# slice (restic-backup.slice) - split eight ways that's 56G/instance,
# with MemoryHigh left a bit lower (40G) so one heavier share throttles
# before hitting its own hard cap. The slice's own 400G/450G stays the
# real backstop if several instances turn out heavier than expected at
# once (see that file).
#
# IMPORTANT: these values assume the host actually has ~500G. Do NOT
# deploy this alongside RESTIC_BACKUP_MAX_PARALLEL=8 on a host with
# less - that recreates the OOM/reboot these limits exist to prevent.
# For the previous, 64G-VM sizing (RESTIC_BACKUP_MAX_PARALLEL=4,
# MemoryHigh=12G/MemoryMax=16G, slice 40G/48G), see git history.
#
# To confirm actual usage once running: `systemctl status
# restic-backup@<share>.service` while it runs shows current/peak
# `Memory:`. If real shares need more headroom than this, raise both
# here and in restic-backup.slice to match, and redeploy - or
# `systemctl edit restic-backup@.service` for a quick local override
# without waiting on that.
MemoryHigh=40G
MemoryMax=56G
Slice=restic-backup.slice

# Run as a low-priority, low-io-priority background job so it doesn't
# starve interactive workloads on the host.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# All activity is already logged to $LOG_DIR/backup.log by the script
# itself; also send stdout/stderr to the journal so `journalctl -u
# restic-backup@<share>.service` and log_error()/log_warn() lines are
# visible there too.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=restic-backup-%i

# Basic hardening. Loosen ProtectSystem/ReadWritePaths if the service
# user needs write access outside of the cache/tmp/log directories.
# IMPORTANT: every path listed here must already exist on disk before
# the service starts - systemd bind-mounts them into the sandbox
# before ExecStart runs and will NOT create them (fails with
# "226/NAMESPACE" if one is missing). If you change RESTIC_CACHE_DIR
# or RESTIC_TMP_DIR in restic.env, update this list and mkdir the new
# paths to match.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/restic/restic-cache /opt/restic/restic-tmp /var/log/restic
# /run/restic/restic.lock - shared with every other restic-backup@.service
# instance (any number of shares can back up at once) and exclusive
# with restic-maintenance.service / restic-forget.sh (never alongside
# a prune). See acquire_lock() in bin/restic-common.sh.
RuntimeDirectory=restic
RuntimeDirectoryPreserve=yes

TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

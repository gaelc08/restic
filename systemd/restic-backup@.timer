[Unit]
Description=Daily timer for restic backup of share %i

[Timer]
# Daily at 01:00 local time. restic-maintenance.timer fires at 00:00
# (i.e. just before this, at the end of the previous day's cycle), so
# under normal conditions it never overlaps this job; the lock in
# bin/restic-common.sh (acquire_lock) is the actual guarantee - and
# since every restic-backup@.service instance only ever takes that
# lock in shared mode, any number of shares can run this at the same
# time without waiting on each other.
OnCalendar=*-*-* 01:00:00
# Spread real start time over 10 minutes - both to avoid every share
# hitting the S3 endpoint in the same second, and because systemd
# picks an independent random delay per timer instance, which already
# staggers shares relative to each other.
RandomizedDelaySec=600
# If the host was off/asleep at 01:00, run as soon as possible after
# boot instead of silently skipping a day.
Persistent=true

[Install]
WantedBy=timers.target

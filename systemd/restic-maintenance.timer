[Unit]
Description=Run restic maintenance (forget/prune/check) daily

[Timer]
# Daily at 04:00 local time - after restic-backup.timer (01:00 +
# up to 10 min random delay) is expected to have finished. Widen the
# gap if backups regularly take longer than ~3 hours.
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target

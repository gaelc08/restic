[Unit]
Description=Run restic maintenance (forget/prune/check) daily

[Timer]
# Daily at 00:00 (midnight) local time - the last job of the day,
# roughly 23 hours after restic-backup.timer's 01:00 start, giving the
# backup as much of the day as possible to finish. This is a
# convenience, not a hard guarantee: restic-maintenance.service takes
# the same lock (/run/restic/restic.lock) as restic-backup.service
# and exits immediately without doing anything if a backup is still
# running when it fires - see bin/restic-maintenance.sh.
OnCalendar=*-*-* 00:00:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target

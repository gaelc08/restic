[Unit]
Description=restic maintenance (forget/prune retention + check) for S3 Glacier repository
Documentation=https://restic.readthedocs.io/
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/restic/restic.env

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/restic.env
ExecStart=/opt/restic/bin/restic-maintenance.sh

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

StandardOutput=journal
StandardError=journal
SyslogIdentifier=restic-maintenance

# IMPORTANT: every path in ReadWritePaths must already exist on disk
# before the service starts - systemd bind-mounts them into the
# sandbox before ExecStart runs and will NOT create them (fails with
# "226/NAMESPACE" if one is missing). If you change RESTIC_CACHE_DIR
# or RESTIC_TMP_DIR in restic.env, update this list and mkdir the new
# paths to match.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/restic/restic-cache /opt/restic/restic-tmp /var/log/restic
# /run/restic/restic.lock - shared with every restic-backup@.service
# instance, but in exclusive mode (they take it shared, so any number
# of them run in parallel; this takes it exclusive, so it never runs
# alongside any of them). If the lock is already held by one or more
# backups, this service exits 0 immediately without doing anything -
# see bin/restic-maintenance.sh.
RuntimeDirectory=restic
RuntimeDirectoryPreserve=yes

TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

[Unit]
Description=Regenerate the restic snapshot web report
Documentation=https://restic.readthedocs.io/
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/restic/restic.env

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/restic.env
ExecStart=/opt/restic/bin/restic-webreport.sh

Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

StandardOutput=journal
StandardError=journal
SyslogIdentifier=restic-webreport

# This service only reads fast repository metadata (restic snapshots)
# - never archived pack data - so unlike restic-verify.sh it does not
# take the backup/maintenance lock and is safe to run frequently.
#
# IMPORTANT: every path in ReadWritePaths must already exist on disk
# before the service starts - see the same note in restic-report.service.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/restic/restic-cache /opt/restic/restic-tmp /var/log/restic /var/lib/restic-webreport

TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
